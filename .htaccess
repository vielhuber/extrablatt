# Block direct access to dotfiles and dot directories (.env, .cookies/,
# .cache/, .bin/, .logs/, .git/ etc.). Apache itself refuses to serve a
# file whose name starts with a dot when AllowOverride None is set, but
# many shared hosts are looser — this rule makes the block explicit.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.(?!well-known)" - [F,L]

    # Google rejects OAuth redirect URIs that carry a query string, so the
    # Health callback needs a clean path of its own.
    RewriteRule "^oauth/google$" "index.php?health=callback" [QSA,L]
</IfModule>

# Belt-and-braces: deny direct access to config.json which is technically
# not a dotfile but still secret-laden.
<FilesMatch "^(config\.json|.*\.sqlite)$">
    Require all denied
</FilesMatch>

# Disable gzip / chunked buffering. Without this, mod_deflate accumulates
# roughly 8 KiB before flushing to the client, which makes the live scrape
# output appear in big bursts instead of line by line.
<IfModule mod_deflate.c>
    SetEnvIf Request_URI ".*" no-gzip=1
</IfModule>
